oothing: antialiased; color: lightgrey;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; margin-left: 0.5rem;&quot;&gt;&lt;span class=&quot;coderoad-markdown&quot; style=&quot;box-sizing: border-box;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; line-height: 20px; margin: 0px 0px 0.5rem;&quot;&gt;You should use the &lt;code style=&quot;font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 0, 0); background-color: rgba(27, 31, 35, 0.05); padding: 0.15rem 0.3rem; border-radius: 0.3rem; box-sizing: border-box; font-size: 9.6px; margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;TEXT&lt;/code&gt; data type at least once&lt;/p&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;css-1wjlep9&quot; style=&quot;box-sizing: border-box; margin-left: 0px; margin-bottom: 1rem; display: flex;&quot;&gt;&lt;span class=&quot;next-icon next-icon-success-filling next-xs&quot; style=&quot;box-sizing: border-box; display: inline-block; font-family: NextIcon; -webkit-font-smoothing: antialiased; color: lightgrey;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; margin-left: 0.5rem;&quot;&gt;&lt;span class=&quot;coderoad-markdown&quot; style=&quot;box-sizing: border-box;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; line-height: 20px; margin: 0px 0px 0.5rem;&quot;&gt;You should use the &lt;code style=&quot;font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 0, 0); background-color: rgba(27, 31, 35, 0.05); padding: 0.15rem 0.3rem; border-radius: 0.3rem; box-sizing: border-box; font-size: 9.6px; margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;BOOLEAN&lt;/code&gt; data type on at least two columns&lt;/p&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;css-1wjlep9&quot; style=&quot;box-sizing: border-box; margin-left: 0px; margin-bottom: 1rem; display: flex;&quot;&gt;&lt;span class=&quot;next-icon next-icon-success-filling next-xs&quot; style=&quot;box-sizing: border-box; display: inline-block; font-family: NextIcon; -webkit-font-smoothing: antialiased; color: lightgrey;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; margin-left: 0.5rem;&quot;&gt;&lt;span class=&quot;coderoad-markdown&quot; style=&quot;box-sizing: border-box;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; line-height: 20px; margin: 0px 0px 0.5rem;&quot;&gt;Each &quot;star&quot; should have a foreign key that references one of the rows in &lt;code style=&quot;font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 0, 0); background-color: rgba(27, 31, 35, 0.05); padding: 0.15rem 0.3rem; border-radius: 0.3rem; box-sizing: border-box; font-size: 9.6px; margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;galaxy&lt;/code&gt;&lt;/p&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;css-1wjlep9&quot; style=&quot;box-sizing: border-box; margin-left: 0px; margin-bottom: 1rem; display: flex;&quot;&gt;&lt;span class=&quot;next-icon next-icon-success-filling next-xs&quot; style=&quot;box-sizing: border-box; display: inline-block; font-family: NextIcon; -webkit-font-smoothing: antialiased; color: lightgrey;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; margin-left: 0.5rem;&quot;&gt;&lt;span class=&quot;coderoad-markdown&quot; style=&quot;box-sizing: border-box;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; line-height: 20px; margin: 0px 0px 0.5rem;&quot;&gt;Each &quot;planet&quot; should have a foreign key that references one of the rows in &lt;code style=&quot;font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 0, 0); background-color: rgba(27, 31, 35, 0.05); padding: 0.15rem 0.3rem; border-radius: 0.3rem; box-sizing: border-box; font-size: 9.6px; margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;star&lt;/code&gt;&lt;/p&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;css-1wjlep9&quot; style=&quot;box-sizing: border-box; margin-left: 0px; margin-bottom: 1rem; display: flex;&quot;&gt;&lt;span class=&quot;next-icon next-icon-success-filling next-xs&quot; style=&quot;box-sizing: border-box; display: inline-block; font-family: NextIcon; -webkit-font-smoothing: antialiased; color: lightgrey;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; margin-left: 0.5rem;&quot;&gt;&lt;span class=&quot;coderoad-markdown&quot; style=&quot;box-sizing: border-box;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; line-height: 20px; margin: 0px 0px 0.5rem;&quot;&gt;Each &quot;moon&quot; should have a foreign key that references one of the rows in &lt;code style=&quot;font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 0, 0); background-color: rgba(27, 31, 35, 0.05); padding: 0.15rem 0.3rem; border-radius: 0.3rem; box-sizing: border-box; font-size: 9.6px; margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;planet&lt;/code&gt;&lt;/p&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;css-1wjlep9&quot; style=&quot;box-sizing: border-box; margin-left: 0px; margin-bottom: 1rem; display: flex;&quot;&gt;&lt;span class=&quot;next-icon next-icon-success-filling next-xs&quot; style=&quot;box-sizing: border-box; display: inline-block; font-family: NextIcon; -webkit-font-smoothing: antialiased; color: lightgrey;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; margin-left: 0.5rem;&quot;&gt;&lt;span class=&quot;coderoad-markdown&quot; style=&quot;box-sizing: border-box;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; line-height: 20px; margin: 0px 0px 0.5rem;&quot;&gt;Your database should have at least five tables&lt;/p&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&