 margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;star&lt;/code&gt; tables should each have at least six rows&lt;/p&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;css-1wjlep9&quot; style=&quot;box-sizing: border-box; margin-left: 0px; margin-bottom: 1rem; display: flex;&quot;&gt;&lt;span class=&quot;next-icon next-icon-success-filling next-xs&quot; style=&quot;box-sizing: border-box; display: inline-block; font-family: NextIcon; -webkit-font-smoothing: antialiased; color: lightgrey;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; margin-left: 0.5rem;&quot;&gt;&lt;span class=&quot;coderoad-markdown&quot; style=&quot;box-sizing: border-box;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; line-height: 20px; margin: 0px 0px 0.5rem;&quot;&gt;The &lt;code style=&quot;font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 0, 0); background-color: rgba(27, 31, 35, 0.05); padding: 0.15rem 0.3rem; border-radius: 0.3rem; box-sizing: border-box; font-size: 9.6px; margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;planet&lt;/code&gt; table should have at least 12 rows&lt;/p&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;css-1wjlep9&quot; style=&quot;box-sizing: border-box; margin-left: 0px; margin-bottom: 1rem; display: flex;&quot;&gt;&lt;span class=&quot;next-icon next-icon-success-filling next-xs&quot; style=&quot;box-sizing: border-box; display: inline-block; font-family: NextIcon; -webkit-font-smoothing: antialiased; color: lightgrey;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; margin-left: 0.5rem;&quot;&gt;&lt;span class=&quot;coderoad-markdown&quot; style=&quot;box-sizing: border-box;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; line-height: 20px; margin: 0px 0px 0.5rem;&quot;&gt;The &lt;code style=&quot;font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 0, 0); background-color: rgba(27, 31, 35, 0.05); padding: 0.15rem 0.3rem; border-radius: 0.3rem; box-sizing: border-box; font-size: 9.6px; margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;moon&lt;/code&gt; table should have at least 20 rows&lt;/p&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;css-1wjlep9&quot; style=&quot;box-sizing: border-box; margin-left: 0px; margin-bottom: 1rem; display: flex;&quot;&gt;&lt;span class=&quot;next-icon next-icon-success-filling next-xs&quot; style=&quot;box-sizing: border-box; display: inline-block; font-family: NextIcon; -webkit-font-smoothing: antialiased; color: lightgrey;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; margin-left: 0.5rem;&quot;&gt;&lt;span class=&quot;coderoad-markdown&quot; style=&quot;box-sizing: border-box;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; line-height: 20px; margin: 0px 0px 0.5rem;&quot;&gt;Each table should have at least three columns&lt;/p&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;css-1wjlep9&quot; style=&quot;box-sizing: border-box; margin-left: 0px; margin-bottom: 1rem; display: flex;&quot;&gt;&lt;span class=&quot;next-icon next-icon-success-filling next-xs&quot; style=&quot;box-sizing: border-box; display: inline-block; font-family: NextIcon; -webkit-font-smoothing: antialiased; color: lightgrey;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; margin-left: 0.5rem;&quot;&gt;&lt;span class=&quot;coderoad-markdown&quot; style=&quot;box-sizing: border-box;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; line-height: 20px; margin: 0px 0px 0.5rem;&quot;&gt;The &lt;code style=&quot;font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 0, 0); background-color: rgba(27, 31, 35, 0.05); padding: 0.15rem 0.3rem; border-radius: 0.3rem; box-sizing: border-box; font-size: 9.6px; margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;galaxy&lt;/code&gt;, &lt;code style=&quot;font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 0, 0); background-color: rgba(27, 31, 35, 0.05); padding: 0.15rem 0.3rem; border-radius: 0.3rem; box-sizing: border-box; font-size: 9.6px; margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;star&lt;/code&gt;, &lt;code style=&quot;font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 0, 0); background-color: rgba(27, 31, 35, 0.05); padding: 0.15rem 0.3rem; border-radius: 0.3rem; box-sizing: border-box; font-size: 9.6px; margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;planet&lt;/code&gt;, and &lt;code style=&quot;font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 0, 0); background-color: rgba(27, 31, 35, 0.05); padding: 0.15rem 0.3rem; border-radius: 0.3rem; box-sizing: border-box; font-size: 9.6px; margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;moon&lt;/code&gt; tables should each have at least five columns&lt;/p&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;css-1wjlep9&quot; style=&quot;box-sizing: border-box; margin-left: 0px; margin-bottom: 1rem; display: flex;&quot;&gt;&lt;span class=&quot;next-icon next-icon-success-filling next-xs&quot; style=&quot;box-sizing: border-box; display: inline-block; font-family: NextIcon; -webkit-font-smoothing: antialiased; color: lightgrey;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; margin-left: 0.5rem;&quot;&gt;&lt;span class=&quot;coderoad-markdown&quot; style=&quot;box-sizing: border-box;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; line-height: 20px; margin: 0px 0px 0.5rem;&quot;&gt;At least two columns per table should not accept &lt;code style=&quot;font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 0, 0); background-color: rgba(27, 31, 35, 0.05); padding: 0.15rem 0.3rem; border-radius: 0.3rem; box-sizing: border-box; font-size: 9.6px; margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;NULL&lt;/code&gt; values&lt;/p&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;css-1wjlep9&quot; style=&quot;box-sizing: border-box; margin-left: 0px; margin-bottom: 1rem; display: flex;&quot;&gt;&lt;span class=&quot;next-icon next-icon-success-filling next-xs&quot; style=&quot;box-sizing: border-box; display: inline-block; font-family: NextIcon; -webkit-font-smoothing: antialiased; color: lightgrey;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; margin-left: 0.5rem;&quot;&gt;&lt;span class=&quot;coderoad-markdown&quot; style=&quot;box-sizing: border-box;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; line-height: 20px; margin: 0px 0px 0.5rem;&quot;&gt;At least one column from each table should be required to be &lt;code style=&quot;font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 0, 0); background-color: rgba(27, 31, 35, 0.05); padding: 0.15rem 0.3rem; border-radius: 0.3rem; box-sizing: border-box; font-size: 9.6px; margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;UNIQUE&lt;/code&gt;&lt;/p&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;css-1wjlep9&quot; style=&quot;box-sizing: border-box; margin-left: 0px; margin-bottom: 1rem; display: flex;&quot;&gt;&lt;span class=&quot;next-icon next-icon-success-filling next-xs&quot; style=&quot;box-sizing: border-box; display: inline-block; font-family: NextIcon; -webkit-font-smoothing: antialiased; color: lightgrey;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; margin-left: 0.5rem;&quot;&gt;&lt;span class=&quot;coderoad-markdown&quot; style=&quot;box-sizing: border-box;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; line-height: 20px; margin: 0px 0px 0.5rem;&quot;&gt;All columns named &lt;code style=&quot;font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 0, 0); background-color: rgba(27, 31, 35, 0.05); padding: 0.15rem 0.3rem; border-radius: 0.3rem; box-sizing: border-box; font-size: 9.6px; margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;name&lt;/code&gt; should be of type &lt;code style=&quot;font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 0, 0); background-color: rgba(27, 31, 35, 0.05); padding: 0.15rem 0.3rem; border-radius: 0.3rem; box-sizing: border-box; font-size: 9.6px; margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;VARCHAR&lt;/code&gt;&lt;/p&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;css-1wjlep9&quot; style=&quot;box-sizing: border-box; margin-left: 0px; margin-bottom: 1rem; display: flex;&quot;&gt;&lt;span class=&quot;next-icon next-icon-success-filling next-xs&quot; style=&quot;box-sizing: border-box; display: inline-block; font-family: NextIcon; -webkit-font-smoothing: antialiased; color: lightgrey;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; margin-left: 0.5rem;&quot;&gt;&lt;span class=&quot;coderoad-markdown&quot; style=&quot;box-sizing: border-box;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; line-height: 20px; margin: 0px 0px 0.5rem;&quot;&gt;Each primary key column should follow the naming convention &lt;code style=&quot;font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 0, 0); background-color: rgba(27, 31, 35, 0.05); padding: 0.15rem 0.3rem; border-radius: 0.3rem; box-sizing: border-box; font-size: 9.6px; margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;table_name_id&lt;/code&gt;. For example, the &lt;code style=&quot;font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 0, 0); background-color: rgba(27, 31, 35, 0.05); padding: 0.15rem 0.3rem; border-radius: 0.3rem; box-sizing: border-box; font-size: 9.6px; margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;moon&lt;/code&gt; table should have a primary key column named &lt;code style=&quot;font-family: source-code-pro, Menlo, Monaco, Consolas, &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 0, 0); background-color: rgba(27, 31, 35, 0.05); padding: 0.15rem 0.3rem; border-radius: 0.3rem; box-sizing: border-box; font-size: 9.6px; margin: 0px 2px; white-space: nowrap; border: 1px solid rgb(234, 234, 234);&quot;&gt;moon_id&lt;/code&gt;&lt;/p&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;css-1wjlep9&quot; style=&quot;box-sizing: border-box; margin-left: 0px; margin-bottom: 1rem; display: flex;&quot;&gt;&lt;span class=&quot;next-icon next-icon-success-filling next-xs&quot; style=&quot;box-sizing: border-box; display: inline-block; font-family: NextIcon; -webkit-font-smoothing: antialiased; color: lightgrey;&quot;&gt;&lt;/span&gt;&lt;span style=&quot;box-sizing: border-box; margin-left: 0.5rem;&quot;&gt;&lt;span class=&quot;coderoad-markdown&quot; style=&quot;box-sizing: border-box;&quot;&gt;&lt;p style=&quot;box-sizing: border-box; line-height: 20px; margin: 0px 0px 0.5rem;&quot;&gt;Each foreign key column should have the same name as the column it is referencing&lt;/p&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="450" width="360" x="400" y="320" as="geometry" />
        </mxCell>
